// PROD-1D-C.6R1 — Source-of-truth activation configuration for the notification
// scheduler Worker. This file is the LOCAL target state only.
//
// This Worker is intentionally NOT the Pages project. It runs its own Worker.
//
// IMPORTANT: committing this file locally does NOT activate the remote Worker.
// Remote Worker / version / trigger deployment requires explicit later gates.
//
// Local env (non-committed):
//   OUTBOX_CRON_SECRET = <secret>
//   OUTBOX_CONSUMER_URL = http://127.0.0.1:8788/mock
//   ENVIRONMENT = local

{
  "name": "bathily-convoyage-notification-scheduler",
  "main": "src/workers/notification-scheduler.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["OUTBOX_CRON_SECRET"]
  },
  "vars": {
    "NOTIFICATION_SCHEDULER_ENABLED": "true"
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
